   "source": [
    "for i in range(1, 6):\n",
    "\n",
    "    for j in range(1, i + 1):\n",
    "\n",
    "        if j == 3:\n",
    "            continue\n",
    "\n",
    "        if i * j > 6:\n",
    "            break\n",
    "\n",
    "        print(j, end=\" \")\n",
    "\n",
    "    print()"
   ]
