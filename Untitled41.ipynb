   "source": [
    "total = 0\n",
    "#raghad\n",
    "for i in range(10):\n",
    "    num = int(input(\"Enter a number: \"))\n",
    "#451005003\n",
    "    if num == 0:\n",
    "        break\n",
    "\n",
    "    if num < 0:\n",
    "        continue\n",
    "\n",
    "    if num % 2 == 0:\n",
    "        total += num\n",
    "\n",
    "print(\"Final sum of even positive numbers:\", total)"
   ]
